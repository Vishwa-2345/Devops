# =============================================================================
# SelfHealOps .gitignore
# Merge-only file: rules below are additive. Do NOT commit secrets or runtime
# state. `.env.example` is intentionally tracked.
# =============================================================================

# --- Environment / secrets ---------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*.ppk

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
coverage.xml
.coverage
.coverage.*
backend/.venv/
.venv/
venv/

# --- Databases / local runtime state -----------------------------------------
*.db
*.db-*
*.sqlite
*.sqlite3
*.sqlite-*
*.dump
*.bak
*.backup
backend/data/*
!backend/data/.gitkeep

# --- Node / frontend ---------------------------------------------------------
node_modules/
dist/
build/
frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vite/
*.tsbuildinfo

# --- LLM / local model caches ------------------------------------------------
.ollama/
*.gguf
*.safetensors

# --- Temporary files ---------------------------------------------------------
*.tmp
*.temp
*.pid
tmp/
.temp/

# --- Editors / OS ------------------------------------------------------------
.vscode/
.idea/
.fleet/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Logs --------------------------------------------------------------------
*.log
logs/
