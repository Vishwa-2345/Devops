# =============================================================================
# SelfHealOps configuration
# Copy this file to .env (scripts/setup.sh does this automatically if missing).
# NEVER commit the real .env file — it is git- and docker-ignored.
# =============================================================================

# --- Backend -----------------------------------------------------------------
# API bind host/port for local development and Docker.
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Compose only: host port published for the frontend container.
# FRONTEND_PORT=8080

# Label reported by /api/v1/settings/status (compose defaults this to production).
# ENVIRONMENT=production

# SQLAlchemy database URL. Default stores the SQLite DB in persistent storage.
# Local dev (relative to backend/):  sqlite:///./data/selfhealops.db
# Docker:                            sqlite:////data/selfhealops.db
DATABASE_URL=sqlite:///./data/selfhealops.db

# Comma-separated list of allowed CORS origins.
# The SPA is same-origin in both modes (Vite proxy in dev, nginx proxy in Docker),
# so CORS rarely applies. Include :8080 only if you call the API cross-origin
# from the Docker UI origin.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173,http://127.0.0.1:5173

# --- GitHub integration (optional) ---
# Leave empty to run in unconfigured mode (public repos only, stricter rate limits).
# Create a token at https://github.com/settings/tokens
#   public_repo (or repo for private repositories)
#   actions:read   -> fetch workflow job logs
#   actions:write  -> required for the RERUN_WORKFLOW action
# Put the token ONLY here. Never in frontend code, README examples, Docker
# image layers, or any committed configuration.
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com

# --- LLM provider (optional) ---
# rules  = deterministic rule-based diagnosis (default, no external service)
# ollama = use a local Ollama server, falling back to rules on any failure
LLM_PROVIDER=rules
# In Docker, host-run Ollama is reached via host.docker.internal (see compose).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- Monitoring ---
# Seconds between automatic sync runs. 0 disables background polling entirely
# (the UI/API still supports manual synchronization).
POLL_INTERVAL_SECONDS=0

# --- Security limits ---
MAX_LOG_CHARS=60000
MAX_REQUEST_BODY_BYTES=1048576

# --- Frontend (Vite) ---
# Vite loads its OWN .env from frontend/.env — the ROOT .env is NOT read by Vite.
# The built-in default (/api/v1) is correct for both the dev proxy and the Docker
# nginx proxy, so you normally do not need to set this at all.
# If you do need it, create frontend/.env or export it in your shell.
# VITE_API_BASE_URL=/api/v1
